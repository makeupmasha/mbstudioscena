# Set actual new-owner values in Vercel. Never commit real credentials.
SCENA_PUBLIC_BASE_URL=
SCENA_ADMIN_PASSWORD=
SCENA_TURSO_TURSO_DATABASE_URL=
SCENA_TURSO_TURSO_AUTH_TOKEN=
SCENA_PUBLIC_BLOB_READ_WRITE_TOKEN=
SCENA_PRIVATE_BLOB_READ_WRITE_TOKEN=
SCENA_DEMO_SITE=1
# Optional email delivery: a newly verified sender and the new owner's Resend key.
SCENA_EMAIL_FROM=
RESEND_API_KEY=
# Optional alternative for a platform with independently verified subdomain mail.
SCENA_MAIL_ROOT_DOMAIN=
